		{
			"name": "Tokens",
			"item": [
				{
					"name": "Get Access Tokens of Pages You Manage",
					"id": "17217232-eebd7f36-8b89-407f-8a4e-263191549b40",
					"protocolProfileBehavior": {
						"disableBodyPruning": true
					},
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "User-Agent",
								"value": "Postman/FacebookCollection"
							}
						],
						"url": {
							"raw": "https://graph.facebook.com/{{api_version}}/me/accounts?fields=name,access_token,tasks&access_token={{user_access_token}}",
							"protocol": "https",
							"host": [
								"graph",
								"facebook",
								"com"
							],
							"path": [
								"{{api_version}}",
								"me",
								"accounts"
							],
							"query": [
								{
									"key": "fields",
									"value": "name,access_token,tasks"
								},
								{
									"key": "access_token",
									"value": "{{user_access_token}}"
								}
							]
						},
						"description": "This request uses a **User Access Token** to get a list of all the pages managed by a User. Make sure to choose one page from the response list, copy the `ID` into the `page_id` variable and the `access_token` field into the `page_access_token` variable of the environment.\n\nThis new access token is a **Page Access Token**, which acts on behalf of a Page a user has permission to manage.\n\nMore available fields can be found [here](https://developers.facebook.com/docs/graph-api/reference/page/#fields)."
					},
					"response": [
						{
							"id": "17217232-b0668a7f-9c56-4c90-a5fd-9328f2542634",
							"name": "Get Access Tokens of Pages You Manage",
							"originalRequest": {
								"method": "GET",
								"header": [
									{
										"key": "User-Agent",
										"value": "Postman/FacebookCollection"
									}
								],
								"url": {
									"raw": "https://graph.facebook.com/{{api_version}}/me/accounts?fields=name,access_token,tasks&access_token={{user_access_token}}",
									"protocol": "https",
									"host": [
										"graph",
										"facebook",
										"com"
									],
									"path": [
										"{{api_version}}",
										"me",
										"accounts"
									],
									"query": [
										{
											"key": "fields",
											"value": "name,access_token,tasks"
										},
										{
											"key": "access_token",
											"value": "{{user_access_token}}"
										}
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": null,
							"cookie": [],
							"responseTime": null,
							"body": "{\n    \"data\": [\n        {\n            \"name\": \"{page_name}\",\n            \"access_token\": \"{page_access_token}\",\n            \"id\": \"{page_id}\",\n            \"tasks\": [\n                \"PROFILE_PLUS_ADVERTISE\",\n                \"PROFILE_PLUS_ANALYZE\",\n                \"PROFILE_PLUS_CREATE_CONTENT\",\n                \"PROFILE_PLUS_FACEBOOK_ACCESS\",\n                \"PROFILE_PLUS_MESSAGING\",\n                \"PROFILE_PLUS_MODERATE\",\n                \"PROFILE_PLUS_FULL_CONTROL\",\n                \"PROFILE_PLUS_MANAGE\"\n            ]\n        }\n    ],\n    //...\n    \"paging\": {\n        \"cursors\": {\n            \"before\": \"{cursor}\",\n            \"after\": \"{cursor}\"\n        }\n    }\n}"
						}
					]
				},
				{
					"name": "Get Specific Page Access Token",
					"id": "17217232-6f874cf0-60e7-4bb5-94f7-c63332299a70",
					"protocolProfileBehavior": {
						"disableBodyPruning": true
					},
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "User-Agent",
								"value": "Postman/FacebookCollection"
							}
						],
						"url": {
							"raw": "https://graph.facebook.com/{{api_version}}/{{page_id}}?fields=name,access_token&access_token={{user_access_token}}",
							"protocol": "https",
							"host": [
								"graph",
								"facebook",
								"com"
							],
							"path": [
								"{{api_version}}",
								"{{page_id}}"
							],
							"query": [
								{
									"key": "fields",
									"value": "name,access_token"
								},
								{
									"key": "access_token",
									"value": "{{user_access_token}}"
								}
							]
						},
						"description": "If you already have the `page_id` available, you can query directly this endpoint to get the specific **Page Access Token** you need and avoid having to search for it on the list.\n\nMore available fields can be found [here](https://developers.facebook.com/docs/graph-api/reference/page/#fields)."
					},
					"response": [
						{
							"id": "17217232-6215f148-4acb-4cdb-80f9-adef64ffacc0",
							"name": "Get Specific Page Access Token",
							"originalRequest": {
								"method": "GET",
								"header": [
									{
										"key": "User-Agent",
										"value": "Postman/FacebookCollection"
									}
								],
								"url": {
									"raw": "https://graph.facebook.com/{{api_version}}/{{page_id}}?fields=name,access_token&access_token={{user_access_token}}",
									"protocol": "https",
									"host": [
										"graph",
										"facebook",
										"com"
									],
									"path": [
										"{{api_version}}",
										"{{page_id}}"
									],
									"query": [
										{
											"key": "fields",
											"value": "name,access_token"
										},
										{
											"key": "access_token",
											"value": "{{user_access_token}}"
										}
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": null,
							"cookie": [],
							"responseTime": null,
							"body": "{\n    \"name\": \"{page_name}\",\n    \"access_token\": \"{page_access_token}\",\n    \"id\": \"{page_id}\"\n}"
						}
					]
				}
			],
			"id": "17217232-76eb43e6-c9f0-4982-b29a-1d6e43268dc4",
			"description": "An access token is a string that identifies a user, app or Page and is used by an app to make Graph API calls. This section will cover the basics of tokens used for the Pages API. Make sure the `Facebook` environment is active and the `user_access_token` variable has a value."
		},
